{
  "$schema": "https://www.krakend.io/schema/v2.9/krakend.json",
  "version": 3,
  "name": "iStore API Gateway",
  "port": 8080,
  "timeout": "5s",
  "cache_ttl": "0s",
  "output_encoding": "json",
  "extra_config": {
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[iStore-GW]",
      "syslog": false,
      "stdout": true,
      "format": "default"
    },
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE"],
      "allow_headers": ["Origin", "Authorization", "Content-Type", "X-Idempotency-Key"],
      "expose_headers": ["Content-Length"],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/checkout/produtos",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/produtos",
          "host": ["http://bff-checkout:8081"]
        }
      ]
    },
    {
      "endpoint": "/checkout",
      "method": "POST",
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_local_path": "/etc/krakend/jwk/public.json",
          "cache": true,
          "disable_jwk_security": true,
          "operation_debug": true
        },
        "qos/ratelimit/router": {
          "max_rate": 20,
          "client_max_rate": 3,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/checkout",
          "host": ["http://bff-checkout:8081"]
        }
      ]
    },
    {
      "endpoint": "/checkout/pedidos",
      "method": "GET",
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_local_path": "/etc/krakend/jwk/public.json",
          "cache": true,
          "disable_jwk_security": true,
          "operation_debug": true
        },
        "qos/ratelimit/router": {
          "max_rate": 20,
          "client_max_rate": 5,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/pedidos",
          "host": ["http://bff-checkout:8081"]
        }
      ]
    },
    {
      "endpoint": "/conta/perfil",
      "method": "GET",
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_local_path": "/etc/krakend/jwk/public.json",
          "cache": true,
          "disable_jwk_security": true,
          "operation_debug": true
        }
      },
      "backend": [
        {
          "url_pattern": "/get",
          "host": ["http://mock-backend"]
        }
      ]
    },
    {
      "endpoint": "/catalogo/produtos",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/get",
          "host": ["http://mock-backend"]
        }
      ]
    }
  ]
}
